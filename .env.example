NEXT_PUBLIC_SITE_URL=http://localhost:3000
ADMIN_LOGIN=admin
# Generate: node -e "require('bcryptjs').hash('your-password', 10).then(console.log)"
# ВАЖНО: символы $ в хеше экранируйте обратным слешем, иначе значение
# загрузится пустым: ADMIN_PASSWORD_HASH=\$2b\$10\$....
ADMIN_PASSWORD_HASH=
# Development-only. Ignored when ADMIN_PASSWORD_HASH is set or NODE_ENV=production.
ADMIN_PASSWORD=
SESSION_SECRET=replace-with-at-least-16-random-characters
MAX_UPLOAD_BYTES=10485760
